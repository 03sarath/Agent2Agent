GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# GCS bucket for staging agent code during deployment (must be in same region).
# Create once: gsutil mb -l us-central1 gs://your-project-id-agent-staging
STAGING_BUCKET=gs://your-project-id-agent-staging

# Leave blank for local dev (InMemorySessionService).
# After running deploy.py, paste the resource name here to use Vertex AI sessions.
# Example: projects/my-project/locations/us-central1/reasoningEngines/1234567890
AGENT_ENGINE_RESOURCE_NAME=
